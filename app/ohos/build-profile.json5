{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // 本机只装了 HarmonyOS 6.1.1 (API 24)。flutter create 的模板默认是 5.0.0(12)，
        // 与已安装 SDK 不匹配，DevEco 会报"值不正确"。格式由 hvigor schema 校验：
        // ^((?:[5-9]|[1-9]\d+)\.\d+\.\d+\(\d+\)|...)$
        // 换了机器或装了别的 SDK，改成对应的 主.次.修订(API) 即可。
        "compatibleSdkVersion": "6.1.1(24)",
        "targetSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}